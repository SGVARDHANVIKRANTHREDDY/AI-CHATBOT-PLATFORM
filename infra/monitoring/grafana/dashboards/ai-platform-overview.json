  "panels": [
    {
      "title": "Agent Execution Time (p50 / p95 / p99)",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 0 },
      "targets": [
        {
          "expr": "histogram_quantile(0.50, sum(rate(agent_execution_time_seconds_bucket[5m])) by (le, agent_type))",
          "legendFormat": "p50 {{agent_type}}"
        },
        {
          "expr": "histogram_quantile(0.95, sum(rate(agent_execution_time_seconds_bucket[5m])) by (le, agent_type))",
          "legendFormat": "p95 {{agent_type}}"
        },
        {
          "expr": "histogram_quantile(0.99, sum(rate(agent_execution_time_seconds_bucket[5m])) by (le, agent_type))",
          "legendFormat": "p99 {{agent_type}}"
        }
      ],
      "fieldConfig": {
        "defaults": { "unit": "s" }
      }
    },
    {
      "title": "LLM Token Usage (rate/min)",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 0 },
      "targets": [
        {
          "expr": "sum(rate(llm_token_usage_total[1m])) by (model, type) * 60",
          "legendFormat": "{{model}} / {{type}}"
        }
      ],
      "fieldConfig": {
        "defaults": { "unit": "short" }
      }
    },
    {
      "title": "Vector Search Latency (p50 / p99)",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 8 },
      "targets": [
        {
          "expr": "histogram_quantile(0.50, sum(rate(vector_search_latency_seconds_bucket[5m])) by (le, backend))",
          "legendFormat": "p50 {{backend}}"
        },
        {
          "expr": "histogram_quantile(0.99, sum(rate(vector_search_latency_seconds_bucket[5m])) by (le, backend))",
          "legendFormat": "p99 {{backend}}"
        }
      ],
      "fieldConfig": {
        "defaults": { "unit": "s" }
      }
    },
    {
      "title": "Tool Call Count (rate/min)",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 8 },
      "targets": [
        {
          "expr": "sum(rate(tool_call_count_total[1m])) by (tool_name, status) * 60",
          "legendFormat": "{{tool_name}} ({{status}})"
        }
      ],
      "fieldConfig": {
        "defaults": { "unit": "short" }
      }
    },
    {
      "title": "LLM Call Duration (p50 / p95)",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 16 },
      "targets": [
        {
          "expr": "histogram_quantile(0.50, sum(rate(llm_call_duration_seconds_bucket[5m])) by (le, model, provider))",
          "legendFormat": "p50 {{provider}}/{{model}}"
        },
        {
          "expr": "histogram_quantile(0.95, sum(rate(llm_call_duration_seconds_bucket[5m])) by (le, model, provider))",
          "legendFormat": "p95 {{provider}}/{{model}}"
        }
      ],
      "fieldConfig": {
        "defaults": { "unit": "s" }
      }
    },
    {
      "title": "API Request Latency (p50 / p95 / p99)",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 16 },
      "targets": [
        {
          "expr": "histogram_quantile(0.50, sum(rate(request_latency_seconds_bucket[5m])) by (le, endpoint))",
          "legendFormat": "p50 {{endpoint}}"
        },
        {
          "expr": "histogram_quantile(0.95, sum(rate(request_latency_seconds_bucket[5m])) by (le, endpoint))",
          "legendFormat": "p95 {{endpoint}}"
        },
        {
          "expr": "histogram_quantile(0.99, sum(rate(request_latency_seconds_bucket[5m])) by (le, endpoint))",
