    {
      "title": "RAG Hit/Miss Rate",
      "type": "stat",
      "gridPos": { "h": 4, "w": 6, "x": 0, "y": 24 },
      "targets": [
        {
          "expr": "sum(rate(rag_hits_total{status=\"hit\"}[5m])) / (sum(rate(rag_hits_total[5m])) > 0)",
          "legendFormat": "Hit Rate"
        }
      ],
      "fieldConfig": {
        "defaults": { "unit": "percentunit" }
      }
    },
    {
      "title": "Semantic Cache Hit Rate",
      "type": "stat",
      "gridPos": { "h": 4, "w": 6, "x": 6, "y": 24 },
      "targets": [
        {
          "expr": "sum(rate(semantic_cache_hits_total{status=\"hit\"}[5m])) / (sum(rate(semantic_cache_hits_total[5m])) > 0)",
          "legendFormat": "Cache Hit Rate"
        }
      ],
      "fieldConfig": {
        "defaults": { "unit": "percentunit" }
      }
    },
    {
      "title": "Agent Crashes",
      "type": "stat",
      "gridPos": { "h": 4, "w": 6, "x": 12, "y": 24 },
      "targets": [
        {
          "expr": "sum(increase(agent_crashes_total[1h])) by (agent_type)",
          "legendFormat": "{{agent_type}}"
        }
      ]
    },
    {
      "title": "Hallucination Detections (1h)",
      "type": "stat",
      "gridPos": { "h": 4, "w": 6, "x": 18, "y": 24 },
      "targets": [
        {
          "expr": "sum(increase(hallucination_detections_total[1h]))",
          "legendFormat": "total"
        }
      ]
